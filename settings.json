      "Bash(git rev-parse:*)",
      "Bash(git check-ignore:*)",
      "Bash(rg:*)",
      "Bash(make test:*)",
      "Bash(make check:*)",
      "Bash(make lint:*)",
      "Bash(make build:*)",
      "Bash(pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run check:*)",
      "Bash(npm run build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(go test:*)",
      "Bash(claude-workflow context:*)",
      "Bash(claude-workflow project-id:*)",
      "Bash(claude-workflow graph-status:*)",
      "Bash(claude-workflow graph-doctor:*)",
      "Bash(claude-workflow graph-query:*)",
      "Bash(claude-workflow graph-path:*)",
      "Bash(claude-workflow graph-explain:*)",
      "Bash(claude-workflow graph-affected:*)",
      "Bash(claude-workflow graph-diagnose:*)",
      "Bash(claude-workflow graph-prepare:*)",
      "Bash(claude-workflow graph-validate-chunk:*)",
      "Bash(claude-workflow graph-finalize:*)",
      "Bash(claude-workflow graph-post-commit:*)",
      "Bash(claude-workflow commit:*)",
      "Bash(ask-codex review-plan:*)",
      "Bash(ask-codex decide:*)",
      "Bash(ask-codex status:*)",
      "Bash(ask-codex models:*)",
      "Bash(ask-codex init:*)"
    ],
    "ask": [
      "Bash(ask-codex extend:*)",
      "Bash(~/.claude/bin/ask-codex extend:*)",
      "Bash(~/.local/bin/ask-codex extend:*)",
      "Bash(python3 ~/.claude/bin/ask-codex extend:*)",
      "Bash(python3 -B ~/.claude/bin/ask-codex extend:*)",
      "Bash(ask-codex reset:*)",
      "Bash(~/.claude/bin/ask-codex reset:*)",
      "Bash(~/.local/bin/ask-codex reset:*)",
      "Bash(python3 ~/.claude/bin/ask-codex reset:*)",
      "Bash(python3 -B ~/.claude/bin/ask-codex reset:*)",
      "Bash(ask-codex prune:*)",
      "Bash(~/.claude/bin/ask-codex prune:*)",
      "Bash(~/.local/bin/ask-codex prune:*)",
      "Bash(python3 ~/.claude/bin/ask-codex prune:*)",
      "Bash(python3 -B ~/.claude/bin/ask-codex prune:*)",
      "Bash(ask-codex archive:*)",
      "Bash(~/.claude/bin/ask-codex archive:*)",
      "Bash(~/.local/bin/ask-codex archive:*)",
      "Bash(python3 ~/.claude/bin/ask-codex archive:*)",
      "Bash(python3 -B ~/.claude/bin/ask-codex archive:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(rm:*)"
    ],
    "defaultMode": "auto"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "advisorModel": "opus",
  "theme": "dark",
  "agentPushNotifEnabled": true
}
