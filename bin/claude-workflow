#!/usr/bin/env python3
"""Deterministic Git operations for the Claude workflow."""
import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess


def emit(status, **details):
    print(json.dumps({"status": status, **details}, ensure_ascii=False))


def is_inside(path, boundary):
    """True when `path` is `boundary` or below it, robust to symlinks and case."""
    try:
        current = os.path.realpath(path)
        while True:
            if os.path.samefile(current, boundary):
                return True
            parent = os.path.dirname(current)
            if parent == current:
                return False
            current = parent
    except OSError:
        return False


def repository_boundary(start):
    """The nearest ancestor of `start` holding a .git entry (without running git)."""
    current = os.path.realpath(start)
    while True:
        if os.path.lexists(os.path.join(current, ".git")):
            return current
        parent = os.path.dirname(current)
        if parent == current:
            return os.path.realpath(start)
        current = parent


def trusted_path_entries(boundary):
    """PATH entries that are absolute and outside the repository (never "", ".", or relative)."""
    entries = []
    for entry in os.environ.get("PATH", "").split(os.pathsep):
        if entry and os.path.isabs(entry) and not is_inside(entry, boundary):
            entries.append(entry)
    return entries


def trusted_which(name, boundary):
    for entry in trusted_path_entries(boundary):
        candidate = os.path.join(entry, name)
        if (os.path.isfile(candidate) and os.access(candidate, os.X_OK)
                and not is_inside(candidate, boundary)):
            return candidate
    return None


def run(argv, cwd, check=True, input_text=None, timeout=None, env_extra=None):
    boundary = repository_boundary(cwd)
    env = dict(os.environ)
    entries = trusted_path_entries(boundary) or ["/usr/bin", "/bin"]
    env["PATH"] = os.pathsep.join(entries)
    env.update(env_extra or {})
    if argv and argv[0] == "git":
        # A repository can rewrite objects with refs/replace; never let it do that to a commit.
        env["GIT_NO_REPLACE_OBJECTS"] = "1"
        found = trusted_which("git", boundary)
        if found is None:
            raise RuntimeError("git was not found in an absolute PATH entry outside the repository")
        argv = [found, *argv[1:]]
    result = subprocess.run(argv, cwd=cwd, text=True, capture_output=True, check=False, env=env,
                            input=input_text, timeout=timeout)
    if check and result.returncode:
        detail = (result.stderr or result.stdout or "command failed").strip()[-1000:]
        raise RuntimeError(f"{argv[0]} failed ({result.returncode}): {detail}")
    return result


def git_root(path):
    path = Path(path).resolve()
    result = run(["git", "rev-parse", "--show-toplevel"], path)
    top = Path(result.stdout.strip()).resolve()
    holder = Path(repository_boundary(path))
    try:
        same = os.path.samefile(top, holder)
    except OSError:
        same = False
    if not same:
        raise RuntimeError(
            "git reports a work tree that is not the repository holding its metadata "
            "(a core.worktree redirect?); refusing to act")
    marker = top / ".git"
    if marker.is_dir():
        gitdir = run(["git", "rev-parse", "--absolute-git-dir"], path).stdout.strip()
        if os.path.realpath(gitdir) != os.path.realpath(marker):
            raise RuntimeError("git is using a git directory that is not the repository's own .git "
                               "(an embedded or bare repository?); refusing to act")
    try:
        path.relative_to(top)
    except ValueError as exc:
        raise RuntimeError(
            "the working directory is outside the repository root git reports "
            "(a core.worktree redirect?); refusing to act") from exc
    return top


def head(root):
    return run(["git", "rev-parse", "HEAD"], root).stdout.strip()


def subject(root):
    return run(["git", "show", "-s", "--format=%s", "HEAD"], root).stdout.rstrip("\n")


def names(root, cached=False):
    command = ["git", "diff"]
    if cached:
        command.append("--cached")
    command.extend(["--name-only", "-z"])
    return {item for item in run(command, root).stdout.split("\0") if item}


def validate_subject(value):
    if not value or "\n" in value or "\r" in value or "\0" in value:
        raise ValueError("subject must be one non-empty line")


TRAILER = re.compile(r"^[A-Za-z][A-Za-z0-9-]*: \S[^\r\n\0]*$")
ATTRIBUTION = tuple(re.compile(pattern, re.IGNORECASE) for pattern in (
    r"co-?authored-?by\s*:[^\n]*(claude|anthropic)",
    r"\b(assisted|generated|created|written|authored|reviewed|helped|made)[- ](with|by)\s+(?:the\s+|an?\s+)?(?:ai\s+)?(claude|anthropic)\b",
    r"(assisted|generated|created|written|authored|reviewed|helped)-?(with|by)\s*:[^\n]*(claude|anthropic)",
    r"noreply@anthropic\.com",
    r"(?<![A-Za-z0-9-])(?:www\.)?claude\.(ai|com)/(code|chat|share|claude-code|new|resume|login)\b",
))
CONFUSABLES = str.maketrans({
    "\u0430": "a", "\u0435": "e", "\u043e": "o", "\u0440": "p", "\u0441": "c", "\u0445": "x",
    "\u0443": "y", "\u0455": "s", "\u0456": "i", "\u0458": "j", "\u03bf": "o", "\u03b1": "a",
})


def refuse_attribution(text):
    import unicodedata
    normalized = unicodedata.normalize("NFKC", text)
    normalized = "".join(ch for ch in normalized if unicodedata.category(ch) != "Cf")
    normalized = normalized.translate(CONFUSABLES)
    normalized = re.sub(r"\n[ \t]+", " ", normalized)  # folded continuation lines
    normalized = re.sub(r"\s*:\s*\n\s*", ": ", normalized)
    for pattern in ATTRIBUTION:
        if pattern.search(normalized):
            raise ValueError("commit messages must not carry AI attribution, session links, "
                             "or Co-Authored-By lines for the assistant")


def message_paragraphs(subject_line, body, trailers):
    """Validate the optional body and trailers and return the commit message paragraphs."""
    validate_subject(subject_line)
    refuse_attribution(subject_line)
    paragraphs = [subject_line]
    if body is not None:
        if not body.strip() or "\0" in body or "\r" in body:
            raise ValueError("body must be non-empty text without NUL or carriage returns")
        refuse_attribution(body)
        paragraphs.append(body.strip("\n"))
    for trailer in trailers or []:
        if not TRAILER.match(trailer):
            raise ValueError(f"trailer must be one 'Key: value' line: {trailer!r}")
        refuse_attribution(trailer)
    if trailers:
        paragraphs.append("\n".join(trailers))
    return paragraphs


def message_args(paragraphs):
    return [item for paragraph in paragraphs for item in ("-m", paragraph)]


def full_message(root):
    return run(["git", "show", "-s", "--format=%B", "HEAD"], root).stdout.rstrip("\n")


def validate_paths(root, paths):
    if not paths:
        raise ValueError("at least one exact path is required")
    validated = []
    for raw in paths:
        if (raw in {".", ".."} or Path(raw).is_absolute() or any(c in raw for c in "*?[]")
                or raw.startswith((":", "-"))):
            raise ValueError(f"unsafe or non-exact path: {raw}")
        resolved = (root / raw).resolve()
        try:
            resolved.relative_to(root)
        except ValueError as exc:
            raise ValueError(f"path escapes repository: {raw}") from exc
        if resolved.is_dir():
            raise ValueError(f"directories are not eligible: {raw}")
        tracked = run(["git", "ls-files", "--error-unmatch", "--", raw], root, check=False).returncode == 0
        if not resolved.exists() and not tracked:
            raise ValueError(f"path does not exist and is not tracked: {raw}")
        validated.append(Path(raw).as_posix())
    return validated


def git_metadata_dirs(root):
    """Return the repository's Git metadata directories that removal must never touch."""
    dirs = {root / ".git"}
    result = run(["git", "rev-parse", "--absolute-git-dir"], root, check=False)
    if result.returncode == 0 and result.stdout.strip():
        dirs.add(Path(result.stdout.strip()))
    return {item for item in dirs if item.exists()}


def inside_git_metadata(path, git_dirs):
    """True when path is, or lies inside, a Git metadata directory.

    Compares by file identity, so a case-folded spelling (.Git on a
    case-insensitive filesystem) or a symlink into .git is still recognised.
    """
    for candidate in (path, *path.parents):
        for git_dir in git_dirs:
            try:
                if candidate.exists() and os.path.samefile(candidate, git_dir):
                    return True
            except OSError:
                continue
    return False


def contains_git_metadata(path, git_dirs):
    """True when a Git metadata directory lies at or below path.

    This covers a repository whose Git directory sits inside a subdirectory
    (git init --separate-git-dir): removing that ancestor would destroy history.
    """
    for git_dir in git_dirs:
        for candidate in (git_dir, *git_dir.parents):
            try:
                if os.path.samefile(candidate, path):
                    return True
            except OSError:
                continue
    return False


def names_git_component(relative):
    """True when any component of a repository-relative path is spelled .git in any case."""
    return any(part.casefold() == ".git" for part in relative.parts)


def looks_like_git_dir(path):
    """A bare repository or separate git directory: HEAD, objects/, and refs/."""
    path = Path(path)
    try:
        return (path / "HEAD").is_file() and (path / "objects").is_dir() and (path / "refs").is_dir()
    except OSError:
        return False


def find_nested_git(directory):
    """Repository metadata at or below `directory`: a `.git` entry (directory, gitlink
    file, or symlink) in any case, or a bare or separate git directory."""
    if looks_like_git_dir(directory):
        return Path(directory)
    for current, dirs, files in os.walk(directory, followlinks=False):
        for name in dirs + files:
            if name.casefold() == ".git":
                return Path(current) / name
        for name in dirs:
            if looks_like_git_dir(Path(current) / name):
                return Path(current) / name
    return None


def enclosing_repository(root, target):
    """A nested repository that contains `target`, or None."""
    current = Path(target).parent
    while current != root and root in current.parents:
        if os.path.lexists(current / ".git") or looks_like_git_dir(current):
            return current
        current = current.parent
    return None


def removal_targets(root, paths, recursive):
    if not paths:
        raise ValueError("at least one exact project-relative path is required")
    targets = []
    selected = []
    selected_identities = []
    git_dirs = git_metadata_dirs(root)
    for raw in paths:
        path = Path(raw)
        if (not raw or raw.startswith("-") or path.is_absolute() or raw in {".", ".."}
                or any(part in {".", ".."} for part in path.parts)
                or any(char in raw for char in "*?[]")):
            raise ValueError(f"unsafe or non-exact removal path: {raw}")
        normalized = path.as_posix()
        if any(normalized == existing or normalized.startswith(existing + "/")
               or existing.startswith(normalized + "/") for existing in selected):
            raise ValueError(f"overlapping removal targets are not allowed: {normalized}")
        # Any component spelled .git, in any case, names Git metadata: the
        # repository's own or a nested repository's.
        if names_git_component(path):
            raise ValueError("refusing to remove Git metadata")
        target = root / normalized
        if not target.exists() and not target.is_symlink():
            raise ValueError(f"removal target does not exist: {normalized}")
        parent = target.parent.resolve()
        try:
            relative_parent = parent.relative_to(root)
        except ValueError as exc:
            raise ValueError(f"removal path escapes repository through a parent symlink: {normalized}") from exc
        # A parent that resolves into .git, or through a component named .git
        # (an alias into a nested repository), is Git metadata.
        if names_git_component(relative_parent) or inside_git_metadata(parent, git_dirs):
            raise ValueError("refusing to remove Git metadata")
        # Overlap is judged on resolved identities, so two spellings of one file
        # (a path and the same path through a symlinked directory) cannot both be
        # accepted and leave a partial deletion behind.
        identity = parent / target.name
        if any(identity == other or other in identity.parents or identity in other.parents
               for other in selected_identities):
            raise ValueError(f"overlapping removal targets are not allowed: {normalized}")
        selected_identities.append(identity)
        if target.is_symlink():
            kind = "symlink"
        else:
            resolved = target.resolve()
            try:
                relative_resolved = resolved.relative_to(root)
            except ValueError as exc:
                raise ValueError(f"removal path escapes repository: {normalized}") from exc
            if resolved == root:
                raise ValueError("refusing to remove the repository root")
            if (names_git_component(relative_resolved) or inside_git_metadata(resolved, git_dirs)
                    or contains_git_metadata(resolved, git_dirs)):
                raise ValueError("refusing to remove Git metadata")
            kind = "directory" if target.is_dir() else "file"
            if kind == "directory" and not recursive:
                raise ValueError(f"directory removal requires --recursive: {normalized}")
            if kind == "directory":
                nested = find_nested_git(target)
                if nested is not None:
                    raise ValueError(
                        "refusing to remove a directory that contains a nested Git repository "
                        f"or worktree: {nested.relative_to(root).as_posix()}")
        enclosing = enclosing_repository(root, target)
        if enclosing is not None:
            raise ValueError("refusing to remove a path inside a nested Git repository: "
                             f"{enclosing.relative_to(root).as_posix()}")
        targets.append((normalized, target, kind))
        selected.append(normalized)
    return targets


def remove_paths(root, paths, recursive, confirm):
    """Preview or remove validated project-local paths without following links."""
    targets = removal_targets(root, paths, recursive)
    preview = [{"path": path, "kind": kind} for path, _, kind in targets]
    if not confirm:
        emit("preview", targets=preview,
             next_action="rerun the identical command with --confirm after user approval")
        return
    for _, target, kind in targets:
        if kind == "directory":
            shutil.rmtree(target)
        else:
            target.unlink()
    emit("removed", targets=preview)


def dirty_paths(root):
    result = run(["git", "status", "--porcelain=v1", "-z", "--untracked-files=all"], root, check=False)
    paths = set()
    if result.returncode == 0:
        tokens = result.stdout.split("\0")
        index = 0
        while index < len(tokens):
            item = tokens[index]
            index += 1
            if not item:
                continue
            paths.add(item[3:] if len(item) > 3 else item)
            # A rename or copy entry is followed by its original path, which has
            # no status prefix.
            if len(item) > 3 and (item[0] in "RC" or item[1] in "RC") and index < len(tokens):
                original = tokens[index]
                index += 1
                if original:
                    paths.add(original)
    return paths


def strip_credentials(url):
    """Remove user information, including everything up to the last '@' of the authority."""
    url = re.sub(r"^([A-Za-z][A-Za-z0-9+.-]*://)[^/]*@", r"\1", url)
    return re.sub(r"^[^@/:\s]+:[^@\s]+@", "", url)


def project_id(root):
    remote = run(["git", "remote", "get-url", "origin"], root, check=False).stdout.strip()
    if remote:
        remote = strip_credentials(remote)
        normalized = re.sub(r"^git@([^:]+):", r"https://\1/", remote)
        normalized = re.sub(r"\.git$", "", normalized.rstrip("/"))
        emit("verified", project_id=normalized, source="origin")
        return
    initial = run(["git", "rev-list", "--max-parents=0", "HEAD"], root).stdout.splitlines()[0]
    emit("verified", project_id=f"{root.name}@{initial[:12]}", source="root_commit")


def project_identity(root):
    remote = run(["git", "remote", "get-url", "origin"], root, check=False).stdout.strip()
    if remote:
        remote = strip_credentials(remote)
        normalized = re.sub(r"^git@([^:]+):", r"https://\1/", remote)
        return re.sub(r"\.git$", "", normalized.rstrip("/")), "origin"
    initial = run(["git", "rev-list", "--max-parents=0", "HEAD"], root).stdout.splitlines()[0]
    return f"{root.name}@{initial[:12]}", "root_commit"


def plan_status(text):
    """Return the first `Status:` value of a plan document, or None."""
    for line in text.splitlines():
        match = re.match(r"^Status:\s*(.+?)\s*$", line)
        if match:
            return match.group(1)
    return None


def workflow_context(root):
    identity, identity_source = project_identity(root)
    branch = run(["git", "branch", "--show-current"], root, check=False).stdout.strip()
    plans = root / "docs" / "plans" / "next.md"
    plans_readme = root / "docs" / "plans" / "README.md"
    legacy_plans = root / "docs" / "plans" / "notes.md"
    decisions = root / "docs" / "decisions" / "README.md"
    development = root / "docs" / "development.md"
    plan_text = plans.read_text(encoding="utf-8") if plans.is_file() else ""
    uses_checkboxes = "- [ ]" in plan_text or "- [x]" in plan_text.lower()
    emit(
        "context",
        project_id=identity,
        project_id_source=identity_source,
        branch=branch or None,
        dirty_paths=sorted(dirty_paths(root)),
        guidance="AGENTS.md" if (root / "AGENTS.md").is_file() else None,
        decisions_index="docs/decisions/README.md" if decisions.is_file() else None,
        next_plan="docs/plans/next.md" if plans.is_file() else None,
        next_plan_status=plan_status(plan_text),
        next_plan_has_unfinished=("- [ ]" in plan_text) if uses_checkboxes else None,
        plans_readme="docs/plans/README.md" if plans_readme.is_file() else None,
        legacy_plans="docs/plans/notes.md" if legacy_plans.is_file() else None,
        development="docs/development.md" if development.is_file() else None,
    )


EXEC_KEY = re.compile(
    r".*\.(program|command|driver|cmd|clean|smudge|process|textconv|external|defaultkeycommand)"
    r"|core\.(hookspath|fsmonitor|sshcommand)"
)
TRUTHY = ("true", "yes", "on", "1")


def git_bool_is_true(has_value, value):
    """Read a Git boolean as Git does: a key with no value is true, an integer is true unless zero, and only
    false, no, off, 0 and the empty string are false. Anything unrecognised counts as true, the cautious reading."""
    if not has_value:
        return True
    text = value.strip().lower()
    if text in ("", "false", "no", "off"):
        return False
    try:
        return int(text, 0) != 0
    except ValueError:
        return True


def repo_program_findings(root):
    """Names (never values) of repository-controlled settings that make a commit run a program: filter
    drivers, hooks, a signing or diff program. The owner's own global and system Git configuration is
    trusted and left out, so only the repository (and files it includes) is read."""
    findings = []
    quiet = {"GIT_CONFIG_GLOBAL": os.devnull, "GIT_CONFIG_NOSYSTEM": "1"}
    listing = run(["git", "config", "--list", "-z"], root, check=False, env_extra=quiet)
    if listing.returncode:
        return ["config:unreadable"]
    for entry in listing.stdout.split("\0"):
        key, separator, value = entry.partition("\n")
        lowered = key.lower()
        if EXEC_KEY.fullmatch(lowered) or (lowered == "commit.gpgsign" and git_bool_is_true(bool(separator), value)):
            findings.append(key)
    for flag in ("--absolute-git-dir", "--git-common-dir"):
        directory = run(["git", "rev-parse", flag], root).stdout.strip()
        hooks = os.path.join(directory if os.path.isabs(directory) else os.path.join(str(root), directory), "hooks")
        try:
            names_here = sorted(os.listdir(hooks))
        except OSError:
            continue
        for name in names_here:
            path = os.path.join(hooks, name)
            if not name.endswith(".sample") and os.path.isfile(path) and os.access(path, os.X_OK):
                findings.append("hook:" + name)
    return sorted(set(findings))


def commit(args):
    root = git_root(Path.cwd())
    findings = repo_program_findings(root)
    if findings and not args.allow_repo_programs:
        raise RuntimeError(
            "the repository selects programs the commit would run (%s); refusing "
            "(the owner can pass --allow-repo-programs)" % ", ".join(findings[:8]))
    # Paths are exact file names, never pathspecs with magic.
    os.environ["GIT_LITERAL_PATHSPECS"] = "1"
    paragraphs = message_paragraphs(args.subject, args.body, args.trailer)
    expected_message = "\n\n".join(paragraphs)
    if head(root) != args.expected_head:
        raise RuntimeError("HEAD changed; refusing commit")
    pre_staged = names(root, cached=True)
    if pre_staged and not args.leave_other_staged:
        raise RuntimeError("index is not empty; refusing to alter pre-existing staged work "
                           "(pass --leave-other-staged to commit only the exact paths and keep it staged)")
    normalized = validate_paths(root, args.paths)
    eligible = set(normalized)
    if pre_staged & eligible:
        raise RuntimeError(f"eligible paths already have staged changes: {sorted(pre_staged & eligible)}")
    scope = ["--", *normalized] if pre_staged else []
    run(["git", "diff", "--check", "--", *normalized], root)
    try:
        run(["git", "add", "--", *normalized], root)
        staged = names(root, cached=True) - pre_staged
        if not staged or staged != eligible:
            raise RuntimeError(f"staged paths differ from eligible paths: {sorted(staged)}")
        run(["git", "diff", "--cached", "--check", *scope], root)
        only = ["--only", "--", *normalized] if pre_staged else []
        result = run(["git", "commit", *message_args(paragraphs), *only], root)
    except Exception:
        if head(root) == args.expected_head:
            run(["git", "reset", "--mixed", "HEAD", "--", *normalized], root, check=False)
        raise
    actual = full_message(root)
    if actual != expected_message:
        raise RuntimeError(f"commit message mismatch: {actual!r}")
    committed = {item for item in run(
        ["git", "diff-tree", "--no-commit-id", "--name-only", "-r", "-z", "HEAD"], root
    ).stdout.split("\0") if item}
    if committed != eligible or names(root, cached=True) != pre_staged:
        raise RuntimeError(f"commit contents differ from the eligible paths: {sorted(committed)}")
    os.environ.pop("GIT_LITERAL_PATHSPECS", None)
    emit("committed", commit=head(root), subject=subject(root), paths=sorted(staged),
         left_staged=sorted(pre_staged),
         hook_output=result.stdout.strip()[-500:])


def amend(args):
    root = git_root(Path.cwd())
    paragraphs = message_paragraphs(args.subject, args.body, args.trailer)
    old_hash, old_subject = head(root), subject(root)
    if old_hash != args.expected_head:
        raise RuntimeError("HEAD changed; refusing amend")
    if names(root, cached=True):
        raise RuntimeError("index is not empty; refusing content-changing amend")
    if not args.allow_pushed:
        containing = run(["git", "branch", "-r", "--contains", "HEAD"], root, check=False).stdout.strip()
        if containing:
            raise RuntimeError(
                "HEAD is already pushed (%s); amending would rewrite published history "
                "(pass --allow-pushed to override)" % containing.splitlines()[0].strip())
    known_remote_refs = run(["git", "for-each-ref", "--format=%(refname)", "refs/remotes"],
                            root, check=False).stdout.strip()
    run(["git", "commit", "--amend", *message_args(paragraphs)], root)
    actual = full_message(root)
    if actual != "\n\n".join(paragraphs):
        raise RuntimeError(f"amended message mismatch: {actual!r}")
    details = {}
    if not known_remote_refs:
        details["note"] = ("no remote-tracking refs are known, so whether the old commit was "
                           "pushed could not be checked")
    emit("amended", old_commit=old_hash, new_commit=head(root), old_subject=old_subject,
         subject=subject(root), **details)


def main():
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command", required=True)
    commit_p = sub.add_parser("commit")
    commit_p.add_argument("--expected-head", required=True)
    commit_p.add_argument("--subject", required=True)
    commit_p.add_argument("--body")
    commit_p.add_argument("--trailer", action="append", default=[])
    commit_p.add_argument("--leave-other-staged", action="store_true")
    commit_p.add_argument("--allow-repo-programs", action="store_true")
    commit_p.add_argument("paths", nargs="+")
    amend_p = sub.add_parser("amend-message")
    amend_p.add_argument("--expected-head", required=True)
    amend_p.add_argument("--subject", required=True)
    amend_p.add_argument("--body")
    amend_p.add_argument("--trailer", action="append", default=[])
    amend_p.add_argument("--allow-pushed", action="store_true")
    remove_p = sub.add_parser("remove")
    remove_p.add_argument("--recursive", action="store_true")
    remove_p.add_argument("--confirm", action="store_true")
    remove_p.add_argument("paths", nargs="+")
    for name in ("context", "project-id"):
        item = sub.add_parser(name)
        item.add_argument("root", nargs="?", default=".")
    args = parser.parse_args()
    if args.command == "commit": commit(args)
    elif args.command == "amend-message": amend(args)
    elif args.command == "remove":
        remove_paths(git_root(Path.cwd()), args.paths, args.recursive, args.confirm)
    else:
        root = git_root(Path(args.root))
        if args.command == "context": workflow_context(root)
        else: project_id(root)


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, ValueError) as exc:
        emit("failed", error=str(exc))
        raise SystemExit(1)
    except Exception as exc:  # noqa: BLE001 - a helper must never end in a traceback
        emit("failed", error=f"internal error: {exc.__class__.__name__}: {exc}")
        raise SystemExit(1)
