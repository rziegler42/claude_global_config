#!/usr/bin/env python3
"""Submit reproducible, Git-backed test jobs to configured SSH runners.

The same file is streamed to the remote host for each operation, so a runner
needs only Python 3, Git, SSH access to the repository remote, and the project
toolchain.  Project commands remain in .claude/remote-runner.toml; host details
remain in ~/.claude/remotes.toml.
"""

from __future__ import annotations

import argparse
import base64
import contextlib
import errno
import fcntl
import hashlib
import json
import math
import os
from pathlib import Path
import re
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time
import uuid


CONFIG_PATHS = (
    Path.home() / ".claude" / "remotes.toml",
    Path.home() / ".config" / "remote-runner" / "remotes.toml",
)
JOB_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]*$")
# A project ID names a directory on the runner and is embedded in job IDs, so it
# must be a plain word: no separators, no leading dot, nothing a shell would parse.
PROJECT_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]*$")
# The runner fetches from the repository's origin, so only ordinary transports are
# accepted: https, ssh, or scp-style user@host:path. Nothing may start with "-".
SOURCE_URL = re.compile(
    r"^(https://|ssh://|[A-Za-z0-9][A-Za-z0-9._-]*@[A-Za-z0-9][A-Za-z0-9.-]*:)[^\s\x00-\x1f]+$")
STATE_NAMES = frozenset({"STARTING", "RUNNING", "PASSED", "FAILED", "CANCELLED", "FINISHED",
                         "UNKNOWN_EXIT"})
HEX40 = re.compile(r"^[0-9a-f]{40}$")
SOURCE_REF = re.compile(r"^refs/(heads|tags)/[A-Za-z0-9._/-]{1,200}$")
STARTING_GRACE = 900.0
LOG_LIMIT = 1024 * 1024
ARTIFACT_LIMIT = 2000
REQUIREMENT_KEYS = frozenset({"os", "arch", "min_memory_gib", "min_cpu_cores", "labels"})
SNAPSHOT_MAX_BYTES = 64 * 1024 * 1024
SNAPSHOT_MAX_FILES = 5000
BUNDLE_LIMIT = 256 * 1024 * 1024
HEX64 = re.compile(r"^[0-9a-f]{64}$")
# Run as `python3 -I -c BOOTSTRAP <worker args>`: stdin is "<length>\n", exactly
# that many bytes of this script, then the snapshot bundle, which the script reads.
BOOTSTRAP = (
    "import sys;f=sys.stdin.buffer;n=int(f.readline(24));"
    "0<n<=16777216 or sys.exit('bad script length');s=f.read(n);"
    "len(s)==n or sys.exit('short script');sys.argv=['-']+sys.argv[1:];"
    "exec(compile(s,'remote-runner','exec'),{'__name__':'__main__'})"
)
SNAPSHOT_IDENTITY = {
    "GIT_AUTHOR_NAME": "remote-runner", "GIT_AUTHOR_EMAIL": "noreply",
    "GIT_COMMITTER_NAME": "remote-runner", "GIT_COMMITTER_EMAIL": "noreply",
}
SECRET_NAMES = frozenset({
    "id_rsa", "id_dsa", "id_ecdsa", "id_ed25519", ".netrc", "_netrc", ".git-credentials",
    ".pypirc", ".pgpass", ".dockercfg",
})
SECRET_SUFFIXES = (".key", ".p12", ".pfx", ".jks", ".keystore", ".kdbx", ".ppk")
TEMPLATE_SUFFIXES = (".example", ".sample", ".template", ".dist")
PRIVATE_KEY_MARK = re.compile(rb"-----BEGIN [A-Z0-9 ]*PRIVATE KEY")


def valid_source_url(url: object) -> bool:
    """An ordinary transport, no embedded password, and no option-like user or host."""
    if not isinstance(url, str) or not SOURCE_URL.fullmatch(url):
        return False
    if url.startswith(("https://", "ssh://")):
        authority = url.split("://", 1)[1].split("/", 1)[0]
        userinfo, _, host = authority.rpartition("@")
        if not host or host.startswith("-"):
            return False
        if userinfo and (":" in userinfo or userinfo.startswith("-")):
            return False
    return True


def is_number(value: object) -> bool:
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def finite_number(value: object) -> float | None:
    """A float for a finite, reasonably sized number; None for anything else."""
    if not is_number(value):
        return None
    try:
        number = float(value)  # type: ignore[arg-type]
    except (OverflowError, ValueError):
        return None
    return number if math.isfinite(number) and abs(number) < 1e15 else None


def read_record(path: Path) -> dict[str, object] | None:
    """A job record, or None when it is unreadable, undecodable, or not an object."""
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def retention_days(value: float, name: str) -> float:
    """A retention period must be a finite, non-negative number of days."""
    if not math.isfinite(value) or value < 0:
        fail(f"{name} must be a finite, non-negative number of days")
    return value


def fail(message: str) -> None:
    raise SystemExit(f"remote-runner: {message}")


def b64(value: str) -> str:
    return base64.urlsafe_b64encode(value.encode()).decode()


def unb64(value: str) -> str:
    return base64.urlsafe_b64decode(value.encode()).decode()


def run(argv: list[str], *, cwd: Path | None = None, check: bool = True,
        capture: bool = False) -> subprocess.CompletedProcess[str]:
    return subprocess.run(argv, cwd=cwd, check=check, text=True,
                          capture_output=capture)


def load_remotes() -> dict[str, dict[str, object]]:
    import tomllib  # controller only; the streamed worker needs no TOML
    path = next((item for item in CONFIG_PATHS if item.is_file()), None)
    if path is None:
        fail("no remotes file found (expected ~/.claude/remotes.toml)")
    with path.open("rb") as handle:
        data = tomllib.load(handle)
    remotes = data.get("remotes")
    if not isinstance(remotes, dict):
        fail(f"{path} must contain [remotes.<name>] entries")
    return remotes


def remote_config(name: str) -> dict[str, object]:
    config = load_remotes().get(name)
    if not isinstance(config, dict):
        fail(f"unknown remote {name!r}")
    for required in ("ssh_host", "workspace_root", "max_jobs"):
        if required not in config:
            fail(f"remote {name!r} is missing {required!r}")
    # The workspace root is sent to the runner as a quoted literal, so shell
    # expansions such as $HOME are not performed; a leading ~/ is expanded by the worker.
    if re.search(r"[$`]", str(config["workspace_root"])):
        fail(f"remote {name!r}: workspace_root must be a literal path (or start with ~/), not use $ or backticks")
    return config


def git_value(repo: Path, *args: str) -> str:
    result = run(["git", *args], cwd=repo, capture=True)
    return result.stdout.strip()


def source_ref_for(repo: Path, ref: str) -> str | None:
    """Return a fetchable local branch or tag ref when one names ``ref``."""
    result = run(
        ["git", "rev-parse", "--verify", "--symbolic-full-name", ref],
        cwd=repo, check=False, capture=True,
    )
    candidate = result.stdout.strip()
    if candidate == "HEAD":
        result = run(["git", "symbolic-ref", "--quiet", "HEAD"], cwd=repo,
                     check=False, capture=True)
        candidate = result.stdout.strip()
    if candidate.startswith(("refs/heads/", "refs/tags/")):
        return candidate
    return None


def project_config(repo: Path, revision: str | None = None, git_dir: Path | None = None
                   ) -> tuple[str, dict[str, str], dict[str, dict[str, object]]]:
    """Read the project runner contract.

    With ``revision`` the contract comes from that commit, so the command that
    runs on the runner is the one recorded in the revision under test, not
    whatever the working tree holds.  ``git_dir`` names a repository other than
    ``repo`` that holds the revision, such as a snapshot repository.
    """
    import tomllib  # controller only; the streamed worker needs no TOML
    path = repo / ".claude" / "remote-runner.toml"
    if revision is None:
        if not path.is_file():
            fail(f"missing project runner contract: {path}")
        with path.open("rb") as handle:
            data = tomllib.load(handle)
    else:
        where = ["--git-dir", str(git_dir)] if git_dir is not None else []
        shown = run(["git", *where, "show", f"{revision}:.claude/remote-runner.toml"],
                    cwd=repo, check=False, capture=True)
        if shown.returncode != 0:
            fail(f"the runner contract .claude/remote-runner.toml is not committed in {revision}; commit it first")
        data = tomllib.loads(shown.stdout)
    project = data.get("project")
    profiles = data.get("profiles")
    if not isinstance(project, dict) or not isinstance(project.get("id"), str):
        fail(f"{path} needs [project] id = \"...\"")
    if not PROJECT_ID.fullmatch(project["id"]):
        fail("project id must match [A-Za-z0-9][A-Za-z0-9_-]* (letters, digits, '_' and '-')")
    if not isinstance(profiles, dict):
        fail(f"{path} needs one or more [profiles.<name>] entries")
    commands: dict[str, str] = {}
    requirements: dict[str, dict[str, object]] = {}
    for name, profile in profiles.items():
        if isinstance(profile, dict) and isinstance(profile.get("command"), str):
            commands[name] = profile["command"]
            required = profile.get("requirements", {})
            if not isinstance(required, dict):
                fail(f"profile {name!r} requirements must be a TOML table")
            requirements[name] = required
    if not commands:
        fail(f"{path} has no runnable profiles")
    return project["id"], commands, requirements


class Snapshot:
    """A commit of the working tree held in a temporary repository."""

    def __init__(self, commit: str, base: str, tree: str, git_dir: Path,
                 changed: dict[str, str], total_bytes: int) -> None:
        self.commit, self.base, self.tree = commit, base, tree
        self.git_dir, self.changed, self.total_bytes = git_dir, changed, total_bytes


def show_path(raw: bytes) -> str:
    """A path for a message: decoded, with control characters made visible."""
    text = raw.decode("utf-8", "backslashreplace")
    return re.sub(r"[\x00-\x1f\x7f]", lambda match: "\\x%02x" % ord(match.group()), text)


def snapshot_git(*args: str, cwd: Path | None = None, git_dir: Path | None = None,
                 index: Path | None = None, input: bytes | None = None,
                 identity: bool = False) -> bytes:
    """Run git for the snapshot builder with a scrubbed environment.

    Repository-controlled programs are disabled (hooks, fsmonitor, signing) and
    ambient GIT_* variables that redirect the repository are dropped.
    """
    env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")
           or key in ("GIT_CONFIG_GLOBAL", "GIT_CONFIG_SYSTEM", "GIT_CONFIG_NOSYSTEM")}
    env["GIT_OPTIONAL_LOCKS"] = "0"
    env["GIT_TERMINAL_PROMPT"] = "0"
    if git_dir is not None:
        env["GIT_DIR"] = str(git_dir)
        env["GIT_CONFIG_GLOBAL"] = os.devnull
        env["GIT_CONFIG_NOSYSTEM"] = "1"
    if index is not None:
        env["GIT_INDEX_FILE"] = str(index)
    if identity:
        env.update(SNAPSHOT_IDENTITY)
    result = subprocess.run(
        ["git", "-c", "core.fsmonitor=false", "-c", f"core.hooksPath={os.devnull}",
         "-c", "commit.gpgsign=false", "-c", "core.quotePath=false", *args],
        cwd=cwd, env=env, input=input, capture_output=True, check=False)
    if result.returncode != 0:
        fail("snapshot: git %s failed: %s" % (args[0], result.stderr.decode(errors="replace").strip()))
    return result.stdout


def refuse_secret_name(path: bytes) -> None:
    parts = path.lower().split(b"/")
    name = parts[-1].decode("utf-8", "replace")
    suspicious = (
        name in SECRET_NAMES or name.endswith(SECRET_SUFFIXES)
        or (name == ".env" or name.startswith(".env.")) and not name.endswith(TEMPLATE_SUFFIXES)
        or (name == "credentials" and len(parts) > 1 and parts[-2] == b".aws"))
    if suspicious:
        fail(f"snapshot refused: {show_path(path)} looks like a credential file; "
             "commit it deliberately or remove it from the working tree")


def blob_id(data: bytes) -> bytes:
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest().encode()


def tracked_blob_matches(directory: int, name: bytes, size: int, expected: bytes) -> bool:
    """Stream a large regular file and compare its raw blob id to ``expected``."""
    digest = hashlib.sha1(b"blob %d\0" % size)
    descriptor = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
    seen = 0
    with os.fdopen(descriptor, "rb") as handle:
        if not stat.S_ISREG(os.fstat(handle.fileno()).st_mode):
            return False
        while True:
            chunk = handle.read(1 << 20)
            if not chunk:
                break
            seen += len(chunk)
            if seen > size:
                return False
            digest.update(chunk)
    return seen == size and digest.hexdigest().encode() == expected


def read_worktree_entry(root_fd: int, path: bytes, limit: int, tracked: bytes | None = None
                        ) -> tuple[str, bytes] | None:
    """Read one working-tree entry without following symlinks.

    Returns None when the path is absent, otherwise a (kind, payload) pair:
    ("dir", b""), ("link", target), ("file" or "exec", data), or
    ("same", b"") for a regular file larger than ``limit`` whose raw content
    hashes to ``tracked`` (the index blob id).  No clean filter is applied.
    """
    parts = path.split(b"/")
    if any(part in (b"", b".", b"..") or part.lower() == b".git" for part in parts):
        fail(f"snapshot refused: unsafe path {show_path(path)}")
    directory = os.dup(root_fd)
    try:
        for part in parts[:-1]:
            try:
                following = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                                    dir_fd=directory)
            except OSError as error:
                if error.errno == errno.ENOENT:
                    return None
                try:
                    info = os.stat(part, dir_fd=directory, follow_symlinks=False)
                except OSError:
                    return None
                if stat.S_ISLNK(info.st_mode):
                    fail(f"snapshot refused: {show_path(path)} passes through a symlinked directory")
                return None
            os.close(directory)
            directory = following
        try:
            info = os.stat(parts[-1], dir_fd=directory, follow_symlinks=False)
        except FileNotFoundError:
            return None
        mode = info.st_mode
        if stat.S_ISDIR(mode):
            return ("dir", 0)
        if stat.S_ISLNK(mode):
            return ("link", os.readlink(parts[-1], dir_fd=directory))
        if not stat.S_ISREG(mode):
            fail(f"snapshot refused: {show_path(path)} is not a regular file")
        kind = "exec" if mode & 0o111 else "file"
        if info.st_size > limit:
            if tracked is None or not tracked_blob_matches(directory, parts[-1], info.st_size,
                                                           tracked):
                fail(f"snapshot refused: {show_path(path)} is {info.st_size} bytes; "
                     f"snapshot size limit of {limit} bytes exceeded")
            return ("same:" + kind, b"")
        try:
            descriptor = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                                 dir_fd=directory)
        except OSError:
            fail(f"snapshot refused: {show_path(path)} changed while it was being read")
        with os.fdopen(descriptor, "rb") as handle:
            opened = os.fstat(handle.fileno())
            if not stat.S_ISREG(opened.st_mode):
                fail(f"snapshot refused: {show_path(path)} is not a regular file")
            data = handle.read(limit + 1)
        if len(data) > limit:
            fail(f"snapshot refused: {show_path(path)} exceeds the snapshot size limit of {limit} bytes")
        return (kind, data)
    finally:
        os.close(directory)


@contextlib.contextmanager
def snapshot(repo: Path, *, max_bytes: int = SNAPSHOT_MAX_BYTES,
             max_files: int = SNAPSHOT_MAX_FILES):
    """Build a commit of the working tree on top of HEAD without touching ``repo``.

    Objects are written to a temporary repository that borrows ``repo``'s object
    store, so the source index, refs, stash, and working tree are never changed.
    Files are read with O_NOFOLLOW and hashed without filters; no hook or
    repository-configured program runs.  The yielded ``Snapshot`` is valid only
    inside the ``with`` block.
    """
    head_commit = subprocess.run(["git", "rev-parse", "--verify", "-q", "HEAD^{commit}"], cwd=repo,
                                 capture_output=True, text=True)
    base = head_commit.stdout.strip()
    if head_commit.returncode != 0 or not HEX40.fullmatch(base):
        fail("snapshot: the repository has no commit yet; make an initial commit first")
    fmt = subprocess.run(["git", "rev-parse", "--show-object-format"], cwd=repo,
                         capture_output=True, text=True).stdout.strip() or "sha1"
    if fmt != "sha1":
        fail("snapshot: only SHA-1 repositories are supported")
    objects = Path(snapshot_git("rev-parse", "--path-format=absolute", "--git-path", "objects",
                                cwd=repo).decode().strip())

    head: dict[bytes, tuple[bytes, bytes]] = {}
    for record in snapshot_git("ls-tree", "-r", "-z", base, cwd=repo).split(b"\0"):
        if record:
            meta, _, name = record.partition(b"\t")
            fields = meta.split(b" ")
            head[name] = (fields[0], fields[2])
    entries: dict[bytes, tuple[bytes, bytes]] = {}
    for record in snapshot_git("ls-files", "-s", "-z", cwd=repo).split(b"\0"):
        if record:
            meta, _, name = record.partition(b"\t")
            mode, sha, stage = meta.split(b" ")
            if stage != b"0":
                fail(f"snapshot refused: {show_path(name)} has unresolved merge conflicts")
            entries[name] = (mode, sha)

    # `ls-files -m` would run repository-configured clean filters, so every
    # tracked file is compared by its raw blob id instead.
    others = [item for item in snapshot_git("ls-files", "-z", "-o", "--exclude-standard",
                                            cwd=repo).split(b"\0") if item]
    candidates = set(entries) | set(others)
    filemode = subprocess.run(["git", "config", "--bool", "core.fileMode"], cwd=repo,
                              capture_output=True, text=True).stdout.strip() != "false"

    with tempfile.TemporaryDirectory(prefix="remote-runner-snapshot-") as scratch:
        git_dir = Path(scratch) / "snapshot.git"
        subprocess.run(["git", "init", "--bare", "-q", str(git_dir)], check=True,
                       capture_output=True)
        (git_dir / "objects" / "info").mkdir(parents=True, exist_ok=True)
        (git_dir / "objects" / "info" / "alternates").write_text(str(objects) + "\n")

        fresh: dict[bytes, bytes] = {}
        total = 0
        root_fd = os.open(repo, os.O_RDONLY | os.O_DIRECTORY)
        try:
            for path in sorted(candidates):
                if path.endswith(b"/"):
                    continue  # an untracked nested repository or directory
                if entries.get(path, (b"",))[0] == b"160000":
                    continue  # a gitlink keeps its recorded commit
                tracked = entries.get(path)
                found = read_worktree_entry(root_fd, path, max_bytes,
                                            tracked[1] if tracked else None)
                if found is None:
                    entries.pop(path, None)
                    continue
                kind, data = found
                if kind == "dir":
                    entries.pop(path, None)
                    continue
                if kind.startswith("same:"):
                    kind = kind[5:]
                    if tracked and (filemode or not tracked[0].startswith(b"100")):
                        entries[path] = (b"100755" if kind == "exec" else b"100644", tracked[1])
                    continue
                mode = {"link": b"120000", "exec": b"100755"}.get(kind, b"100644")
                if tracked and not filemode and tracked[0] in (b"100644", b"100755") \
                        and kind != "link":
                    mode = tracked[0]
                if tracked and tracked == (mode, blob_id(data)):
                    continue  # unchanged
                total += len(data)
                if total > max_bytes:
                    fail(f"snapshot refused: {show_path(path)} takes the snapshot past its size "
                         f"limit of {max_bytes} bytes")
                sha = snapshot_git("hash-object", "-w", "--no-filters", "-t", "blob", "--stdin",
                                   git_dir=git_dir, input=data).decode().strip()
                entries[path] = (mode, sha.encode())
                fresh[path] = data
        finally:
            os.close(root_fd)

        changed: dict[str, str] = {}
        for path in sorted(set(entries) | set(head)):
            if path not in entries:
                changed[os.fsdecode(path)] = "deleted"
            elif path not in head:
                changed[os.fsdecode(path)] = "added"
            elif entries[path] != head[path]:
                changed[os.fsdecode(path)] = "modified"
        if len(changed) > max_files:
            fail(f"snapshot refused: {len(changed)} changed files is over the limit of {max_files}")

        for name in changed:
            path = os.fsencode(name)
            if changed[name] == "deleted":
                continue
            refuse_secret_name(path)
            data = fresh.get(path)
            if data is None:
                sha = entries[path][1].decode()
                if entries[path][0] == b"160000":
                    continue
                size = int(snapshot_git("cat-file", "-s", sha, cwd=repo).decode())
                if size > max_bytes:
                    fail(f"snapshot refused: {show_path(path)} exceeds the snapshot size limit "
                         f"of {max_bytes} bytes")
                data = snapshot_git("cat-file", "blob", sha, cwd=repo)
                total += size
            if PRIVATE_KEY_MARK.search(data):
                fail(f"snapshot refused: {show_path(path)} contains a private key")

        index = Path(scratch) / "index"
        records = b"".join(mode + b" " + sha + b"\t" + path + b"\0"
                           for path, (mode, sha) in sorted(entries.items()))
        snapshot_git("update-index", "-z", "--index-info", git_dir=git_dir, index=index,
                     input=records)
        tree = snapshot_git("write-tree", git_dir=git_dir, index=index).decode().strip()
        commit = snapshot_git("commit-tree", "-p", base, "-m", f"remote-runner snapshot of {base}",
                              tree, git_dir=git_dir, identity=True).decode().strip()
        snapshot_git("update-ref", "refs/snapshot/head", commit, git_dir=git_dir)
        yield Snapshot(commit, base, tree, git_dir, changed, total)


def make_bundle(snap: Snapshot, destination: Path) -> tuple[int, str]:
    """Write the snapshot as a bundle on top of its base; return (size, sha256)."""
    snapshot_git("bundle", "create", str(destination), "refs/snapshot/head", f"^{snap.base}",
                 git_dir=snap.git_dir)
    digest = hashlib.sha256()
    size = 0
    with destination.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
            size += len(chunk)
    if size > BUNDLE_LIMIT:
        fail(f"snapshot bundle is {size} bytes, over the limit of {BUNDLE_LIMIT}")
    return size, digest.hexdigest()


def build_payload(bundle: Path, destination: Path) -> None:
    """Length-prefixed copy of this script followed by the bundle (see ``BOOTSTRAP``)."""
    script = Path(__file__).read_bytes()
    with destination.open("wb") as output:
        output.write(b"%d\n" % len(script) + script)
        with bundle.open("rb") as handle:
            shutil.copyfileobj(handle, output, 1 << 20)


def read_bundle(stream, size: int, digest: str, destination: Path) -> None:
    """Receive exactly ``size`` bytes, verify the digest, and refuse trailing data."""
    hasher = hashlib.sha256()
    remaining = size
    with destination.open("wb") as output:
        while remaining:
            chunk = stream.read(min(remaining, 1 << 20))
            if not chunk:
                fail("bundle stream ended early")
            hasher.update(chunk)
            output.write(chunk)
            remaining -= len(chunk)
    if stream.read(1):
        fail("trailing data after the bundle")
    if hasher.hexdigest() != digest:
        fail("bundle digest mismatch")


def capability_mismatches(config: dict[str, object],
                          requirements: dict[str, object]) -> list[str]:
    capabilities = config.get("capabilities", {})
    if not isinstance(capabilities, dict):
        return ["capabilities is not a TOML table"]
    mismatches: list[str] = []
    # Fail closed: a misspelled key or a wrongly typed value must make the
    # runner ineligible, never silently drop the requirement.
    for key in sorted(set(requirements) - REQUIREMENT_KEYS):
        mismatches.append(f"unknown requirement {key!r}")
    for key in ("os", "arch"):
        required = requirements.get(key)
        if required is None:
            continue
        if not isinstance(required, str):
            mismatches.append(f"{key} requirement must be a string")
        elif capabilities.get(key) != required:
            mismatches.append(f"{key}={required!r} required")
    for key in ("min_memory_gib", "min_cpu_cores"):
        required = requirements.get(key)
        if required is None:
            continue
        available_key = key.removeprefix("min_")
        available = capabilities.get(available_key)
        if not is_number(required) or not math.isfinite(required):
            mismatches.append(f"{key} requirement must be a finite number")
        elif not is_number(available) or not math.isfinite(available) or not (available >= required):
            mismatches.append(f"{key}={required} required")
    required_labels = requirements.get("labels", [])
    available_labels = capabilities.get("labels", [])
    if not isinstance(required_labels, list) or not all(isinstance(x, str) for x in required_labels):
        mismatches.append("profile labels must be an array of strings")
    elif not isinstance(available_labels, list) or not all(isinstance(x, str) for x in available_labels):
        mismatches.append("remote labels must be an array of strings")
    else:
        missing = sorted(set(required_labels) - set(available_labels))
        if missing:
            mismatches.append(f"missing labels: {', '.join(missing)}")
    return mismatches


def repository_root() -> Path:
    root = run(["git", "rev-parse", "--show-toplevel"], capture=True).stdout.strip()
    return Path(root)


def remote_name_from_job(job: str) -> str:
    if not JOB_ID.fullmatch(job) or "--" not in job:
        fail("job ID is invalid")
    return job.split("--", 1)[0]


def invoke_worker(remote: str, operation: str, *arguments: str,
                  stream: bool = False, payload: Path | None = None
                  ) -> subprocess.CompletedProcess[bytes]:
    """Run a worker operation; ``payload`` replaces stdin (see ``BOOTSTRAP``)."""
    config = remote_config(remote)
    entry = ["python3", "-I", "-c", BOOTSTRAP] if payload is not None else ["python3", "-I", "-"]
    worker_args = [*entry, "--worker", operation,
                   "--workspace-root", str(config["workspace_root"]),
                   "--max-jobs", str(config["max_jobs"]), *arguments]
    # ssh joins its remote arguments with spaces and gives them to the remote
    # login shell, so every argument is quoted; "--" keeps the host from being
    # read as an ssh option.
    remote_command = " ".join(shlex.quote(item) for item in worker_args)
    with (payload if payload is not None else Path(__file__)).open("rb") as source:
        try:
            return subprocess.run(
                ["ssh", "--", str(config["ssh_host"]), remote_command], stdin=source,
                check=True, capture_output=not stream,
            )
        except subprocess.CalledProcessError as error:
            if stream:
                raise
            detail = error.stderr.decode(errors="replace").strip()
            if "not our ref" in detail:
                fail("the requested commit is not reachable from origin; commit and push it before submitting")
            if "base commit" in detail:
                fail(f"remote {remote!r} {operation} failed: {detail}")
            fail(f"remote {remote!r} {operation} failed: {detail or 'no diagnostic returned'}")


def recommend_remote(requirements: dict[str, object]) -> tuple[str | None, dict[str, object]]:
    candidates: list[dict[str, object]] = []
    ineligible: dict[str, list[str]] = {}
    unavailable: dict[str, str] = {}
    for name, config in sorted(load_remotes().items()):
        if not isinstance(config, dict):
            continue
        mismatches = capability_mismatches(config, requirements)
        if mismatches:
            ineligible[name] = mismatches
            continue
        try:
            availability = json.loads(invoke_worker(name, "availability").stdout)
        except (SystemExit, json.JSONDecodeError) as error:
            unavailable[name] = str(error)
            continue
        if availability.get("available_slots", 0) <= 0:
            unavailable[name] = "no available job slots"
            continue
        capabilities = config.get("capabilities", {})
        candidates.append({
            "name": name, "available_slots": availability["available_slots"],
            "running_jobs": availability["running_jobs"],
            "memory_gib": capabilities.get("memory_gib", 0),
            "cpu_cores": capabilities.get("cpu_cores", 0),
            "labels": capabilities.get("labels", []),
        })
    candidates.sort(
        key=lambda item: (
            item["available_slots"], item["memory_gib"], item["cpu_cores"], item["name"],
        ),
        reverse=True,
    )
    recommendation = candidates[0]["name"] if candidates else None
    return recommendation, {
        "requirements": requirements, "recommended": recommendation,
        "eligible": candidates, "ineligible": ineligible, "unavailable": unavailable,
    }


def submit_snapshot(args: argparse.Namespace, repo: Path) -> None:
    """Send a snapshot of the working tree to a runner as a bundle over SSH."""
    # SIGTERM must unwind the context managers, or the temporary snapshot
    # repository (which holds uncommitted file contents) would be left behind.
    def terminate(signum: int, frame: object) -> None:
        raise SystemExit(128 + signum)
    previous = signal.signal(signal.SIGTERM, terminate)
    try:
        _submit_snapshot(args, repo)
    finally:
        signal.signal(signal.SIGTERM, previous)


def _submit_snapshot(args: argparse.Namespace, repo: Path) -> None:
    with snapshot(repo) as snap:
        project, profiles, requirements = project_config(repo, revision=snap.commit,
                                                         git_dir=snap.git_dir)
        if args.profile not in profiles:
            fail(f"unknown profile {args.profile!r}; available: {', '.join(sorted(profiles))}")
        remote = args.remote
        if args.best:
            remote, report = recommend_remote(requirements[args.profile])
            if remote is None:
                fail(f"no eligible available remote for profile {args.profile!r}: {json.dumps(report)}")
        source_url = git_value(repo, "remote", "get-url", "origin")
        if not valid_source_url(source_url):
            fail("origin URL must be https://, ssh:// or scp-style user@host:path, "
                 "without an embedded password")
        source_ref = source_ref_for(repo, "HEAD")
        job = f"{remote}--{project}--{time.strftime('%Y%m%d-%H%M%S')}--{uuid.uuid4().hex[:8]}"
        if not JOB_ID.fullmatch(job):
            fail("remote or project name makes an invalid job ID")
        with tempfile.TemporaryDirectory(prefix="remote-runner-payload-") as scratch:
            bundle = Path(scratch) / "snapshot.bundle"
            size, digest = make_bundle(snap, bundle)
            payload = Path(scratch) / "payload"
            build_payload(bundle, payload)
            result = invoke_worker(
                remote, "submit-snapshot", "--job", job, "--project", b64(project),
                "--source-url", b64(source_url), "--commit", snap.commit, "--base", snap.base,
                "--bundle-size", str(size), "--bundle-sha256", digest,
                *( ["--source-ref", b64(source_ref)] if source_ref else []),
                "--command", b64(profiles[args.profile]), payload=payload,
            )
        try:
            data = json.loads(result.stdout.decode())
        except ValueError:
            print(result.stdout.decode(), end="")
            return
        data.update({"profile": args.profile, "command": profiles[args.profile],
                     "source": source_url, "snapshot": True, "commit": snap.commit,
                     "base_commit": snap.base, "changed_files": len(snap.changed)})
        print(json.dumps(data, indent=2))


def controller(args: argparse.Namespace) -> None:
    if args.action == "remotes":
        for name, config in sorted(load_remotes().items()):
            capabilities = config.get("capabilities", {})
            memory = capabilities.get("memory_gib", "?") if isinstance(capabilities, dict) else "?"
            cores = capabilities.get("cpu_cores", "?") if isinstance(capabilities, dict) else "?"
            print(f"{name}\t{config.get('ssh_host')}\tjobs={config.get('max_jobs')}\t{cores} cores\t{memory} GiB")
        return

    if args.action == "recommend":
        repo = repository_root()
        _, profiles, requirements = project_config(repo)
        if args.profile not in profiles:
            fail(f"unknown profile {args.profile!r}; available: {', '.join(sorted(profiles))}")
        _, report = recommend_remote(requirements[args.profile])
        print(json.dumps(report, indent=2))
        return

    if args.action == "submit" and args.snapshot:
        submit_snapshot(args, repository_root())
        return

    if args.action == "submit":
        repo = repository_root()
        ref = args.ref or "HEAD"
        if ref.startswith("-"):
            fail("--ref must not start with '-'")
        commit = git_value(repo, "rev-parse", "--verify", f"{ref}^{{commit}}")
        project, profiles, requirements = project_config(repo, revision=commit)
        if args.profile not in profiles:
            fail(f"unknown profile {args.profile!r}; available: {', '.join(sorted(profiles))}")
        remote = args.remote
        if args.best:
            remote, report = recommend_remote(requirements[args.profile])
            if remote is None:
                fail(f"no eligible available remote for profile {args.profile!r}: {json.dumps(report)}")
        source_url = git_value(repo, "remote", "get-url", "origin")
        if not valid_source_url(source_url):
            fail("origin URL must be https://, ssh:// or scp-style user@host:path, "
                 "without an embedded password")
        source_ref = source_ref_for(repo, ref)
        job = f"{remote}--{project}--{time.strftime('%Y%m%d-%H%M%S')}--{uuid.uuid4().hex[:8]}"
        if not JOB_ID.fullmatch(job):
            fail("remote or project name makes an invalid job ID")
        result = invoke_worker(
            remote, "submit", "--job", job, "--project", b64(project),
            "--source-url", b64(source_url), "--commit", commit,
            *( ["--source-ref", b64(source_ref)] if source_ref else []),
            "--command", b64(profiles[args.profile]),
        )
        try:
            data = json.loads(result.stdout.decode())
        except ValueError:
            print(result.stdout.decode(), end="")
            return
        data.update({"profile": args.profile, "command": profiles[args.profile],
                     "source": source_url, "ref": ref})
        print(json.dumps(data, indent=2))
        return

    if args.action == "prune":
        retention_days(args.success_days, "--success-days")
        retention_days(args.failure_days, "--failure-days")
        result = invoke_worker(
            args.remote, "prune", "--success-days", str(args.success_days),
            "--failure-days", str(args.failure_days),
            *( ["--apply"] if args.apply else []),
        )
        print(result.stdout.decode(), end="")
        return

    remote = remote_name_from_job(args.job)
    if args.action == "log":
        invoke_worker(remote, "log", "--job", args.job,
                      *( ["--follow"] if args.follow else []), stream=True)
        return
    result = invoke_worker(remote, args.action, "--job", args.job)
    print(result.stdout.decode(), end="")


def process_start(pid: int) -> str | None:
    """An identifier for this incarnation of a pid, so a reused pid is not mistaken for the job."""
    try:
        data = Path(f"/proc/{pid}/stat").read_text(errors="replace")
        return "proc:" + data.rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError, ValueError):
        pass
    try:
        started = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], capture_output=True,
                                 text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None
    return "ps:" + started if started else None


def job_process_alive(metadata: dict[str, object], *, require_identity: bool = False) -> bool:
    """Whether the recorded pid is this job's process.

    A record that carries ``pid_start`` is verified against the running process.
    A record without one predates start times; it may still be counted for
    capacity, but ``require_identity`` (used before signalling) refuses it.
    """
    pid = metadata.get("pid")
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 1:
        return False
    try:
        os.kill(pid, 0)
    except (ProcessLookupError, PermissionError, OverflowError):
        return False
    recorded = metadata.get("pid_start")
    if not isinstance(recorded, str):
        return not require_identity
    current = process_start(pid)
    return current is not None and current == recorded


def refresh_state(metadata: dict[str, object], metadata_path: Path) -> bool:
    """Return whether the recorded job process remains live."""
    if metadata.get("state") == "STARTING":
        created = finite_number(metadata.get("created_at"))
        if created is not None and 0 <= time.time() - created < STARTING_GRACE:
            return True
        metadata["state"] = "FAILED"
        metadata_path.write_text(json.dumps(metadata, indent=2) + "\n")
        return False
    # The exit-status file is located from the job directory, never from a path
    # recorded in metadata, which the job itself can rewrite. Once it exists the
    # job's command has finished, so no live process can be the job.
    result = metadata_path.parent / "exit-status"
    # A record that proves its process identity is judged by that process, so a
    # job cannot hide itself (or dodge cancel) by writing exit-status early.
    finished = (metadata.get("state") == "RUNNING" and result.is_file()
                and not isinstance(metadata.get("pid_start"), str))
    # Metadata is job-writable, so a recorded pid is only a hint: 0 or 1, a pid
    # owned by another user, a reused pid (start time differs), or an out-of-range
    # value are not this job's process and must neither crash the runner nor keep
    # the job "live".
    if not finished and job_process_alive(metadata):
        return True
    if metadata.get("state") == "RUNNING":
        if result.is_file() and result.read_text().strip() == "0":
            metadata["state"] = "PASSED"
        elif result.is_file():
            metadata["state"] = "FAILED"
        else:
            metadata["state"] = "UNKNOWN_EXIT"
        metadata_path.write_text(json.dumps(metadata, indent=2) + "\n")
    return False


def public_view(metadata: dict[str, object]) -> dict[str, object]:
    """The job record as reported to the caller: typed, bounded, and marked untrusted.

    The metadata file is writable by the job itself, so nothing in it is
    authoritative. Only allow-listed, validated fields are returned.
    """
    def word(value: object, pattern: re.Pattern[str]) -> str | None:
        return value if isinstance(value, str) and pattern.fullmatch(value) else None

    commit = word(metadata.get("commit"), HEX40)
    dut_commit = word(metadata.get("dut_commit"), HEX40)
    dut_clean = metadata.get("dut_clean") if isinstance(metadata.get("dut_clean"), bool) else None
    if commit is None or dut_commit is None or dut_clean is None:
        integrity = "invalid"
    elif commit != dut_commit or dut_clean is not True:
        integrity = "mismatch"
    else:
        integrity = "ok"
    state = metadata.get("state")
    created = finite_number(metadata.get("created_at"))
    pid = metadata.get("pid")
    return {
        "untrusted_job_data": True,
        "job": word(metadata.get("job"), JOB_ID),
        "project": word(metadata.get("project"), PROJECT_ID),
        "state": state if isinstance(state, str) and state in STATE_NAMES else "UNKNOWN",
        "commit": commit,
        "dut_commit": dut_commit,
        "dut_clean": dut_clean,
        "integrity": integrity,
        "snapshot": metadata.get("snapshot") is True,
        "base_commit": word(metadata.get("base_commit"), HEX40),
        "source_ref": word(metadata.get("source_ref"), SOURCE_REF),
        "created_at": created,
        "pid": pid if isinstance(pid, int) and not isinstance(pid, bool) and abs(pid) < 2 ** 31 else None,
        "note": "job-writable record; compare dut_commit with the commit you submitted",
    }


def read_log(path: Path) -> str:
    """The tail of a job log: never through a link, bounded, without control characters."""
    try:
        descriptor = os.open(str(path), os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0))
    except OSError:
        return "[run.log is missing or is not a regular file]\n"
    with os.fdopen(descriptor, "rb") as handle:
        info = os.fstat(handle.fileno())
        if not stat.S_ISREG(info.st_mode):
            return "[run.log is not a regular file]\n"
        omitted = info.st_size > LOG_LIMIT
        if omitted:
            handle.seek(info.st_size - LOG_LIMIT)
        data = handle.read(LOG_LIMIT)
    text = data.decode("utf-8", errors="replace")
    cleaned = "".join(ch if ch in "\n\t" or ch.isprintable() else "?" for ch in text)
    return ("[earlier output omitted]\n" if omitted else "") + cleaned


def availability_worker(jobs_root: Path, max_jobs: int) -> None:
    running = 0
    for metadata_path in jobs_root.glob("*/metadata.json"):
        if metadata_path.parent.is_symlink():
            continue
        metadata = read_record(metadata_path)
        if metadata is None:
            continue
        try:
            if refresh_state(metadata, metadata_path):
                running += 1
        except (OSError, ValueError, OverflowError, TypeError):
            continue
    print(json.dumps({
        "running_jobs": running,
        "max_jobs": max_jobs,
        "available_slots": max(0, max_jobs - running),
    }))


def prune_worker(root: Path, projects_root: Path, jobs_root: Path,
                 args: argparse.Namespace) -> None:
    retention_days(args.success_days, "--success-days")
    retention_days(args.failure_days, "--failure-days")
    now = time.time()
    candidates: list[dict[str, object]] = []
    for metadata_path in sorted(jobs_root.glob("*/metadata.json")):
        if metadata_path.parent.is_symlink() or metadata_path.parent.parent != jobs_root:
            continue
        metadata = read_record(metadata_path)
        job_dir = metadata_path.parent
        if metadata is None:
            continue
        try:
            if refresh_state(metadata, metadata_path):
                continue
        except (OSError, ValueError, OverflowError, TypeError):
            continue
        state_value = metadata.get("state", "UNKNOWN_EXIT")
        state = state_value if isinstance(state_value, str) and state_value in STATE_NAMES else "UNKNOWN_EXIT"
        created = finite_number(metadata.get("created_at"))
        timestamp = created if created is not None else job_dir.stat().st_mtime
        age_days = (now - timestamp) / 86400
        limit = args.success_days if state == "PASSED" else args.failure_days
        if age_days < limit:
            continue
        size = sum(path.stat().st_size for path in job_dir.rglob("*") if path.is_file())
        # Identify the job, its worktree and its project from the directory the
        # runner created, not from metadata a job can rewrite.
        project = metadata.get("project")
        cache = metadata.get("cache")
        valid_project = project if isinstance(project, str) and PROJECT_ID.fullmatch(project) else None
        valid_cache = cache if isinstance(cache, str) and PROJECT_ID.fullmatch(cache) else None
        candidates.append({
            "job": job_dir.name, "state": state,
            "age_days": round(age_days, 1), "size_bytes": size,
            "worktree": str(job_dir / "worktree"),
            "project": valid_project,
            # Jobs recorded before caches were keyed by origin used the project directory.
            "cache": valid_cache or valid_project,
        })

    if args.apply:
        removed: list[str] = []
        for item in candidates:
            job = str(item["job"])
            job_dir = jobs_root / job
            worktree = item.get("worktree")
            cache = item.get("cache")
            if isinstance(worktree, str) and isinstance(cache, str):
                bare = projects_root / cache / "repo.git"
                if bare.is_dir():
                    subprocess.run(
                        ["git", "--git-dir", str(bare), "worktree", "remove", "--force", worktree],
                        check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    )
            if JOB_ID.fullmatch(job):
                # The job record names its cache but a job can rewrite it, so the
                # snapshot ref (named from the runner-created directory) is
                # removed from every cache.
                for bare in sorted(projects_root.glob("*/repo.git")):
                    if bare.is_dir() and not bare.is_symlink():
                        subprocess.run(
                            ["git", "--git-dir", str(bare), "update-ref", "-d",
                             f"refs/snapshots/{job}"],
                            check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                        )
            try:
                if job_dir.parent == jobs_root and job_dir.is_dir() and not job_dir.is_symlink():
                    shutil.rmtree(job_dir)
                    removed.append(job)
            except OSError:
                continue
        print(json.dumps({"mode": "applied", "removed": removed}, indent=2))
    else:
        print(json.dumps({"mode": "preview", "candidates": candidates}, indent=2))


def worker(args: argparse.Namespace) -> None:
    root = Path(args.workspace_root).expanduser().resolve()
    jobs_root = root / "jobs"
    projects_root = root / "projects"
    jobs_root.mkdir(parents=True, exist_ok=True)
    projects_root.mkdir(parents=True, exist_ok=True)
    if args.worker_action == "availability":
        availability_worker(jobs_root, args.max_jobs)
        return
    if args.worker_action == "prune":
        prune_worker(root, projects_root, jobs_root, args)
        return
    if args.job is None:
        fail("job ID is required")
    if not JOB_ID.fullmatch(args.job):
        fail("job ID is invalid")
    job_dir = jobs_root / args.job
    metadata_path = job_dir / "metadata.json"

    if args.worker_action in ("submit", "submit-snapshot"):
        snapshot_mode = args.worker_action == "submit-snapshot"
        if snapshot_mode:
            if not (args.commit and HEX40.fullmatch(args.commit)
                    and args.base and HEX40.fullmatch(args.base)):
                fail("snapshot commit and base must be 40-character object IDs")
            if not (args.bundle_sha256 and HEX64.fullmatch(args.bundle_sha256)):
                fail("bundle digest must be a SHA-256 hex string")
            if args.bundle_size is None or not 0 < args.bundle_size <= BUNDLE_LIMIT:
                fail(f"bundle size is outside the limit of {BUNDLE_LIMIT} bytes")
        project = unb64(args.project)
        source_url = unb64(args.source_url)
        source_ref = unb64(args.source_ref) if args.source_ref else None
        command = unb64(args.command)
        if source_ref is not None and not SOURCE_REF.fullmatch(source_ref):
            fail("source ref must be refs/heads/... or refs/tags/...")
        if not snapshot_mode and not (args.commit and HEX40.fullmatch(args.commit)):
            fail("commit must be a 40-character object ID")
        if not PROJECT_ID.fullmatch(project):
            fail("project ID contains unsupported characters")
        if not valid_source_url(source_url):
            fail("source URL must be https://, ssh:// or scp-style user@host:path, "
                 "without an embedded password")
        # Reserve the slot atomically: count live jobs and create this job's
        # directory under one lock, so concurrent submissions cannot all pass the
        # capacity check before any of them is recorded.
        with open(jobs_root / ".submit.lock", "a+") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            if job_dir.exists():
                fail(f"job already exists: {args.job}")
            running = 0
            for record in jobs_root.glob("*/metadata.json"):
                if record.parent.is_symlink():
                    continue
                existing = read_record(record)
                if existing is None:
                    continue
                try:
                    if refresh_state(existing, record):
                        running += 1
                except (OSError, ValueError, OverflowError, TypeError):
                    continue
            if running >= args.max_jobs:
                fail(f"runner capacity reached ({running}/{args.max_jobs} jobs running)")
            job_dir.mkdir()
            metadata_path.write_text(json.dumps({
                "job": args.job, "project": project, "state": "STARTING", "pid": None,
                "created_at": time.time(),
            }, indent=2) + "\n")
        try:
            # The object cache is keyed by project and origin, so two repositories that
            # claim the same project ID cannot share, or repoint, one another's objects.
            cache = f"{project}-{hashlib.sha256(source_url.encode()).hexdigest()[:12]}"
            bare = projects_root / cache / "repo.git"
            bare.parent.mkdir(parents=True, exist_ok=True)
            if not bare.exists():
                run(["git", "init", "--bare", str(bare)], capture=True)
                run(["git", "-C", str(bare), "remote", "add", "--", "origin", source_url], capture=True)
            else:
                run(["git", "-C", str(bare), "remote", "set-url", "--", "origin", source_url], capture=True)
            wanted = args.base if snapshot_mode else args.commit
            if snapshot_mode:
                read_bundle(sys.stdin.buffer, args.bundle_size, args.bundle_sha256,
                            job_dir / "snapshot.bundle")
            try:
                run([
                    "git", "-c", "protocol.allow=never", "-c", "protocol.https.allow=always",
                    "-c", "protocol.ssh.allow=always", "-C", str(bare),
                    "fetch", "--prune", "origin", "--", source_ref or wanted,
                ], capture=True)
                run(["git", "-C", str(bare), "cat-file", "-e", f"{wanted}^{{commit}}"], capture=True)
            except subprocess.CalledProcessError:
                if snapshot_mode:
                    fail("runner could not fetch the base commit from origin; push it first")
                fail("runner could not fetch the requested revision from origin; push the branch or tag first")
            if snapshot_mode:
                bundle_file = job_dir / "snapshot.bundle"
                try:
                    run(["git", "-C", str(bare), "bundle", "verify", str(bundle_file)], capture=True)
                    run(["git", "-c", "transfer.fsckObjects=true", "-C", str(bare), "fetch",
                         "--no-tags", str(bundle_file),
                         f"refs/snapshot/head:refs/snapshots/{args.job}"], capture=True)
                except subprocess.CalledProcessError:
                    fail("snapshot bundle failed verification")
                bundle_file.unlink(missing_ok=True)  # the objects now live in the cache
                if git_value(bare, "rev-parse", f"refs/snapshots/{args.job}") != args.commit:
                    fail("snapshot commit does not match the declared commit")
                lineage = git_value(bare, "rev-list", "--parents", "-n", "1", args.commit).split()
                if lineage != [args.commit, args.base]:
                    fail("snapshot commit does not sit directly on the declared base")

            worktree = job_dir / "worktree"
            run(["git", "--git-dir", str(bare), "worktree", "add", "--detach", str(worktree), args.commit], capture=True)
            dut_commit = git_value(worktree, "rev-parse", "HEAD")
            dut_clean = not git_value(worktree, "status", "--porcelain")
            if dut_commit != args.commit or not dut_clean:
                subprocess.run(
                    ["git", "--git-dir", str(bare), "worktree", "remove", "--force", str(worktree)],
                    check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                )
                shutil.rmtree(job_dir, ignore_errors=True)
                fail("remote DUT checkout did not match the requested clean commit")
            log = job_dir / "run.log"
            exit_status = job_dir / "exit-status"
            shell_command = (
                f"cd {shlex.quote(str(worktree))} && {command}; result=$?; "
                f"printf '%s\\n' \"$result\" > {shlex.quote(str(exit_status))}; "
                "exit \"$result\""
            )
            with log.open("wb") as output:
                process = subprocess.Popen(
                    ["bash", "-lc", shell_command],
                    stdout=output, stderr=subprocess.STDOUT, start_new_session=True,
                )
            metadata = {
                "job": args.job, "project": project, "cache": cache, "commit": args.commit,
                "source_ref": source_ref, "dut_commit": dut_commit, "dut_clean": dut_clean,
                "command": command, "created_at": time.time(), "pid": process.pid,
                "state": "RUNNING", "worktree": str(worktree), "log": str(log),
                "exit_status": str(exit_status), "pid_start": process_start(process.pid),
                "record_version": 2,
            }
            if snapshot_mode:
                metadata.update({"snapshot": True, "base_commit": args.base,
                                 "snapshot_ref": f"refs/snapshots/{args.job}"})
            metadata_path.write_text(json.dumps(metadata, indent=2) + "\n")
            print(json.dumps({
                "job": args.job, "state": "RUNNING", "pid": process.pid,
                "dut_commit": dut_commit, "dut_clean": dut_clean,
                **({"snapshot": True, "base_commit": args.base} if snapshot_mode else {}),
            }, indent=2))
        except BaseException:
            if snapshot_mode:
                subprocess.run(
                    ["git", "--git-dir", str(bare), "update-ref", "-d", f"refs/snapshots/{args.job}"],
                    check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                )
            subprocess.run(
                ["git", "--git-dir", str(bare), "worktree", "remove", "--force", str(job_dir / "worktree")],
                check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
            shutil.rmtree(job_dir, ignore_errors=True)
            raise
        return

    if job_dir.is_symlink() or not metadata_path.is_file():
        fail(f"unknown job: {args.job}")
    metadata = read_record(metadata_path)
    if metadata is None:
        fail(f"job record is unreadable: {args.job}")
    pid = metadata.get("pid")
    if args.worker_action == "status":
        refresh_state(metadata, metadata_path)
        print(json.dumps(public_view(metadata), indent=2))
    elif args.worker_action == "cancel":
        # Bring the record up to date first: a finished job whose record still
        # says RUNNING must never lead to signalling a pid the kernel has reused.
        refresh_state(metadata, metadata_path)
        if (metadata.get("state") == "RUNNING"
                and job_process_alive(metadata, require_identity=True)
                and isinstance(pid, int) and not isinstance(pid, bool) and pid > 1):
            try:
                os.killpg(pid, signal.SIGTERM)
                metadata["state"] = "CANCELLED"
            except (ProcessLookupError, PermissionError, OverflowError):
                metadata["state"] = "FINISHED"
            metadata_path.write_text(json.dumps(metadata, indent=2) + "\n")
        print(json.dumps(public_view(metadata), indent=2))
    elif args.worker_action == "log":
        log = job_dir / "run.log"
        if args.follow:
            if log.is_symlink() or not log.is_file():
                print("[run.log is missing or is not a regular file]")
            else:
                follower = subprocess.Popen(["tail", "-n", "+1", "-f", str(log)],
                                            stdout=subprocess.PIPE, text=True, errors="replace")
                sent = 0
                try:
                    for line in follower.stdout:  # type: ignore[union-attr]
                        clean = "".join(ch if ch in "\n\t" or ch.isprintable() else "?" for ch in line)
                        print(clean, end="", flush=True)
                        sent += len(clean)
                        if sent > 10 * LOG_LIMIT:
                            print("\n[output limit reached]")
                            break
                finally:
                    follower.terminate()
        else:
            print(read_log(log), end="")
    elif args.worker_action == "artifacts":
        entries: list[str] = []
        truncated = False
        for current, _dirs, files in os.walk(job_dir, followlinks=False):
            for name in files:
                full = os.path.join(current, name)
                if os.path.islink(full):
                    continue
                if len(entries) >= ARTIFACT_LIMIT:
                    truncated = True
                    break
                entries.append(os.path.relpath(full, job_dir))
            if truncated:
                break
        print(json.dumps({"job": args.job, "files": entries, "truncated": truncated,
                          "untrusted_job_data": True}, indent=2))


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    sub = result.add_subparsers(dest="action", required=True)
    sub.add_parser("remotes", help="list configured runners")
    recommend = sub.add_parser("recommend", help="show eligible available runners for a profile")
    recommend.add_argument("--profile", required=True)
    submit = sub.add_parser("submit", help="submit a pushed branch, tag, or commit")
    selection = submit.add_mutually_exclusive_group(required=True)
    selection.add_argument("--remote")
    selection.add_argument("--best", action="store_true",
                           help="choose the best eligible available remote")
    submit.add_argument("--profile", required=True)
    source = submit.add_mutually_exclusive_group()
    source.add_argument(
        "--ref", help="local branch, tag, or commit already reachable from origin (default: HEAD)",
    )
    source.add_argument(
        "--snapshot", action="store_true",
        help="test the working tree, including uncommitted and untracked files, as a bundle "
             "on top of HEAD (HEAD must be reachable from origin)",
    )
    prune = sub.add_parser("prune", help="preview or remove expired jobs")
    prune.add_argument("--remote", required=True)
    prune.add_argument("--success-days", type=float, default=7)
    prune.add_argument("--failure-days", type=float, default=30)
    prune.add_argument("--apply", action="store_true",
                       help="remove previewed jobs; omission is a preview")
    for name in ("status", "log", "artifacts", "cancel"):
        item = sub.add_parser(name)
        item.add_argument("job")
        if name == "log":
            item.add_argument("--follow", action="store_true")
    return result


def worker_parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(add_help=False)
    result.add_argument("--worker", dest="worker_action", required=True,
                        choices=("submit", "submit-snapshot", "status", "log", "artifacts", "cancel",
                                     "prune", "availability"))
    result.add_argument("--workspace-root", required=True)
    result.add_argument("--max-jobs", type=int, required=True)
    result.add_argument("--job")
    result.add_argument("--project")
    result.add_argument("--source-url")
    result.add_argument("--source-ref")
    result.add_argument("--commit")
    result.add_argument("--command")
    result.add_argument("--base")
    result.add_argument("--bundle-size", type=int)
    result.add_argument("--bundle-sha256")
    result.add_argument("--follow", action="store_true")
    result.add_argument("--success-days", type=float, default=7)
    result.add_argument("--failure-days", type=float, default=30)
    result.add_argument("--apply", action="store_true")
    return result


if __name__ == "__main__":
    if "--worker" in sys.argv:
        worker(worker_parser().parse_args())
    else:
        controller(parser().parse_args())
